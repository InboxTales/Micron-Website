# Micron Wires (www.micronwires.in) - Hostinger web hosting (LiteSpeed / Apache)
# Deployed as part of out/ into public_html. Pages live at /about/ etc. (folders with index.html).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. One canonical address: https://www.micronwires.in
  RewriteCond %{HTTP_HOST} ^micronwires\.in$ [NC]
  RewriteRule ^ https://www.micronwires.in%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.micronwires\.in$ [NC]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.micronwires.in%{REQUEST_URI} [L,R=301]

  # 2. Old-style links (/index.html, /about.html, /about/index.html) -> clean URLs
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [L,R=301]
  RewriteCond %{THE_REQUEST} \s/+(.+?)(?:/index)?\.html[\s?] [NC]
  RewriteCond %1 !^404$
  RewriteRule ^ /%1/ [L,R=301]

  # 3. Pages end with a slash: /about -> /about/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # Pages and page data: always revalidate so updates show immediately
  <FilesMatch "\.(html|txt|xml|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Build files have content hashes in their names: cache for a year
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Photos, logos and icons: 30 days
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # The quote form endpoint must never be cached
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Compression (LiteSpeed also compresses automatically)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType image/avif .avif
  AddCharset utf-8 .html .txt .xml .webmanifest .css .js
</IfModule>

# Block hidden files such as .htaccess, .git and .env
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
